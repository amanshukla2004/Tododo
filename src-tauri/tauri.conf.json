{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "tododo",
  "version": "0.1.0",
  "identifier": "com.tododo.desktop",
  "build": {
    "frontendDist": "../src",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Tododo",
        "label": "main",
        "width": 350,
        "height": 520,
        "minWidth": 280,
        "minHeight": 320,
        "maxWidth": 480,
        "maxHeight": 720,
        "resizable": true,
        "maximizable": false,
        "fullscreen": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": false,
        "alwaysOnBottom": true,
        "skipTaskbar": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
